<%# app/views/inventory_items/_inventory_table.html.erb %>
<div class="bg-white rounded-[2.5rem] border border-slate-200 shadow-xl shadow-slate-200/40 overflow-hidden">
  <table class="w-full text-left border-collapse table-auto">
    <thead>
      <tr class="bg-slate-50/50 border-b border-slate-100">
        <th class="px-8 py-6 text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">Resource Asset</th>
        <th class="px-8 py-6 text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">Stock Level</th>
        <th class="px-8 py-6 text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">Status</th>
        <th class="px-8 py-6 text-[10px] font-black uppercase tracking-[0.2em] text-slate-400 text-right">Vault Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-50">
      <% if items.any? %>
        <%= render partial: 'inventory_item', collection: items, as: :inventory_item %>
      <% else %>
        <tr>
          <td colspan="4" class="px-8 py-24 text-center">
            <div class="flex flex-col items-center justify-center">
              <div class="h-16 w-16 bg-slate-50 rounded-full flex items-center justify-center mb-4 border border-slate-100">
                <svg class="w-8 h-8 text-slate-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0a2 2 0 012 2v4a2 2 0 01-2 2H4a2 2 0 01-2-2v-4a2 2 0 012-2m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" stroke-width="2"/>
                </svg>
              </div>
              <p class="text-sm font-bold text-slate-400 uppercase tracking-widest">The vault is currently empty</p>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>