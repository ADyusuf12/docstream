<%# app/views/inventory_items/_inventory_item.html.erb %>
<% is_low = inventory_item.quantity <= inventory_item.low_stock_threshold %>
<tr class="group hover:bg-slate-50 transition-all duration-200" id="<%= dom_id(inventory_item) %>">
  <td class="px-8 py-4 align-middle">
    <div class="flex items-center gap-4">
      <div class="h-10 w-10 rounded-xl flex items-center justify-center shrink-0 <%= is_low ? 'bg-rose-100 text-rose-600' : 'bg-emerald-100 text-emerald-600' %> shadow-sm">
        <svg style="width: 20px; height: 20px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" stroke-width="2"/>
        </svg>
      </div>
      <div>
        <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest leading-none mb-1"><%= inventory_item.category %></p>
        <%= link_to inventory_item_path(inventory_item), class: "text-sm font-bold text-slate-900 hover:text-emerald-600" do %>
          <%= inventory_item.name %>
        <% end %>
      </div>
    </div>
  </td>
  <td class="px-8 py-4 align-middle">
    <div class="flex flex-col">
      <span class="text-base font-black text-slate-900 tabular-nums">
        <%= number_with_delimiter(inventory_item.quantity) %>
      </span>
      <span class="text-[10px] font-bold text-slate-400 uppercase"><%= inventory_item.unit %></span>
    </div>
  </td>
  <td class="px-8 py-4 align-middle">
    <% if is_low %>
      <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-rose-50 text-rose-700 border border-rose-100">Critical</span>
    <% else %>
      <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-100">Stable</span>
    <% end %>
  </td>
  <td class="px-8 py-4 align-middle">
    <div class="flex justify-end items-center">
      <%= link_to new_restock_inventory_item_path(inventory_item),
          class: "inline-flex items-center bg-slate-900 text-white px-4 py-2 rounded-lg font-black text-[10px] uppercase tracking-widest hover:bg-emerald-600 transition-all shadow-sm" do %>
        <span style="white-space: nowrap;">Restock Vault</span>
      <% end %>
    </div>
  </td>
</tr>