<!DOCTYPE html>
<html>
  <head>
    <title>Docstream | TIRS Workflow</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css">
    <style>
      body { font-family: 'Inter', sans-serif; }
    </style>
  </head>
  <body class="bg-[#F1F5F9] text-slate-900 min-h-screen flex flex-col">
    <nav class="sticky top-0 z-40 bg-tirs-dark/95 backdrop-blur-md border-b border-white/10 shadow-2xl">
      <div class="container mx-auto px-6">
        <div class="flex justify-between items-center h-20">
          <div class="flex items-center group cursor-pointer">
            <div class="relative">
              <div class="absolute -inset-1 bg-gradient-to-r from-emerald-400 to-tirs-light rounded blur opacity-25 group-hover:opacity-50 transition duration-1000"></div>
              <div class="relative bg-white text-tirs-dark h-11 w-11 rounded-xl flex items-center justify-center font-black text-xl shadow-lg transform group-hover:rotate-3 transition-transform">
                DS
              </div>
            </div>
            <div class="ml-4">
              <span class="font-black text-xl tracking-tight block leading-none text-white uppercase">
                TIRS <span class="text-tirs-light italic">WMS</span>
              </span>
              <span class="text-[9px] uppercase tracking-[0.3em] font-bold text-emerald-200/60 block mt-1">
                Government of Taraba State
              </span>
            </div>
          </div>
          <div class="hidden lg:flex items-center bg-white/5 rounded-2xl p-1.5 border border-white/10">
            <%= link_to documents_path, class: "px-5 py-2 rounded-xl text-sm font-bold transition-all flex items-center #{current_page?(documents_path) ? 'bg-white text-tirs-dark shadow-lg' : 'text-emerald-50 hover:bg-white/10'}" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" stroke-width="2"/></svg>
              Registry
            <% end %>
            <%= link_to workflow_instances_path, class: "px-5 py-2 rounded-xl text-sm font-bold transition-all flex items-center #{current_page?(workflow_instances_path) ? 'bg-white text-tirs-dark shadow-lg' : 'text-emerald-50 hover:bg-white/10'}" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" stroke-width="2"/></svg>
              Workflows
            <% end %>
            <% if current_user&.admin? %>
              <%= link_to admin_audits_path, class: "px-5 py-2 rounded-xl text-sm font-bold transition-all flex items-center #{current_page?(admin_audits_path) ? 'bg-white text-tirs-dark shadow-lg' : 'text-emerald-50 hover:bg-white/10'}" do %>
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" stroke-width="2"/></svg>
                Audit
              <% end %>
            <% end %>
          </div>
          <div class="flex items-center space-x-4">
            <% if user_signed_in? %>
              <div class="bg-black/20 rounded-full pl-4 pr-1.5 py-1.5 flex items-center border border-white/10">
                <div class="text-right mr-3">
                  <p class="text-[10px] font-black text-tirs-light uppercase leading-none mb-0.5 tracking-tighter">
                    <%= current_user.role %> Account
                  </p>
                  <p class="text-xs font-bold text-white/90 leading-none">
                  </p>
                </div>
                <div class="h-8 w-8 rounded-full bg-gradient-to-br from-emerald-400 to-tirs-medium flex items-center justify-center text-xs font-bold text-white border-2 border-white/20">
                  <%= current_user.email[0].upcase %>
                </div>
              </div>
              <div class="h-6 w-px bg-white/10"></div>
              <%= button_to destroy_user_session_path, method: :delete,
              class: "p-2 rounded-xl text-emerald-200 hover:bg-rose-500/20 hover:text-rose-300 transition-all duration-300" do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                </svg>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </nav>
    <main class="container mx-auto flex-grow mt-8 mb-12 px-6">
      <div class="max-w-4xl mx-auto">
        <% if notice %>
          <div class="mb-6 p-4 bg-emerald-50 border-l-4 border-emerald-500 text-emerald-800 text-sm font-medium rounded shadow-sm animate-fade-in-down">
            <div class="flex items-center">
              <svg class="h-5 w-5 mr-2" fill="currentColor" viewBox="0 0 20 20"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"/></svg>
              <%= notice %>
            </div>
          </div>
        <% end %>
        <% if alert %>
          <div class="mb-6 p-4 bg-rose-50 border-l-4 border-rose-500 text-rose-800 text-sm font-medium rounded shadow-sm animate-fade-in-down">
            <div class="flex items-center">
              <svg class="h-5 w-5 mr-2" fill="currentColor" viewBox="0 0 20 20"><path d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"/></svg>
              <%= alert %>
            </div>
          </div>
        <% end %>
        <%= yield %>
      </div>
    </main>
    <footer class="bg-white border-t border-slate-200 py-6">
      <div class="container mx-auto px-6 text-center text-slate-400 text-[11px] uppercase tracking-widest font-semibold">
        © <%= Time.current.year %> Taraba Board of Internal Revenue Service — Digital Handover System
      </div>
    </footer>
    <% if user_signed_in? %>
      <%= render "shared/role_switcher" %>
    <% end %>
  </body>
</html>