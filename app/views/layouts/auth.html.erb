<!DOCTYPE html>
<html>
  <head>
    <title>TIRS | Secure Authorization</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-slate-100">
    <%# Flash messages for login errors %>
    <% if alert %>
      <div class="fixed top-6 left-1/2 -translate-x-1/2 z-50 bg-rose-600 text-white px-6 py-3 rounded-2xl text-[10px] font-black uppercase tracking-widest shadow-2xl animate-bounce">
        <%= alert %>
      </div>
    <% end %>
    <%= yield %>
  </body>
</html>