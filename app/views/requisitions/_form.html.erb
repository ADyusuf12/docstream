<%# app/views/requisitions/_form.html.erb %>
<%= form_with(model: requisition, class: "space-y-8") do |f| %>
  <% if requisition.errors.any? %>
    <div class="mb-6 p-4 bg-rose-50 border-l-4 border-rose-500 rounded-r-xl">
      <p class="text-xs font-black text-rose-600 uppercase tracking-widest mb-2">Please correct the following:</p>
      <ul class="text-sm text-rose-700 font-medium list-disc list-inside">
        <% requisition.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="bg-white rounded-[2.5rem] border border-slate-200 shadow-xl shadow-slate-200/50 overflow-hidden">
    <div class="p-8 md:p-12 space-y-10">
      <%# Item Selection %>
      <div class="space-y-4">
        <label class="block text-[10px] font-black text-slate-400 uppercase tracking-[0.2em]">Select Security Item / Stationary</label>
        <div class="relative">
          <%= f.collection_select :inventory_item_id, @inventory_items, :id, :name,
              { prompt: "CHOOSE ITEM FROM VAULT..." },
              { class: "w-full bg-slate-50 border-2 border-slate-100 rounded-2xl px-6 py-4 font-bold text-slate-700 focus:border-emerald-500 focus:ring-0 transition-all appearance-none cursor-pointer" } %>
          <div class="absolute inset-y-0 right-5 flex items-center pointer-events-none text-slate-400">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"></svg>
          </div>
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <%# Quantity %>
        <div class="space-y-4">
          <label class="block text-[10px] font-black text-slate-400 uppercase tracking-[0.2em]">Quantity Requested</label>
          <%= f.number_field :quantity_requested, min: 1, placeholder: "0",
              class: "w-full bg-slate-50 border-2 border-slate-100 rounded-2xl px-6 py-4 font-bold text-slate-700 focus:border-emerald-500 focus:ring-0 transition-all" %>
        </div>
        <%# Visual Hint %>
        <div class="bg-emerald-50 rounded-2xl p-4 flex items-center border border-emerald-100">
          <div class="h-10 w-10 bg-emerald-500 text-white rounded-xl flex items-center justify-center mr-3 shadow-lg shadow-emerald-200 shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" stroke-width="2"/></svg>
          </div>
          <p class="text-[10px] text-emerald-800 font-bold leading-tight uppercase tracking-tight">
            Approved requests will be deducted from central inventory immediately upon Chairman's signature.
          </p>
        </div>
      </div>
      <%# Purpose %>
      <div class="space-y-4">
        <label class="block text-[10px] font-black text-slate-400 uppercase tracking-[0.2em]">Purpose of Requisition</label>
        <%= f.text_area :purpose, rows: 4, placeholder: "e.g., Issuance to Revenue Officer for Timber & Produce collection...",
            class: "w-full bg-slate-50 border-2 border-slate-100 rounded-[2rem] px-8 py-6 font-medium text-slate-700 focus:border-emerald-500 focus:ring-0 transition-all" %>
      </div>
    </div>
    <%# Submit Footer %>
    <div class="bg-slate-50 p-8 border-t border-slate-100 flex justify-end">
      <%= f.submit "Submit Requisition",
          class: "bg-slate-900 text-white px-10 py-4 rounded-2xl font-black text-xs uppercase tracking-widest hover:bg-emerald-600 hover:shadow-2xl hover:shadow-emerald-200 transition-all cursor-pointer" %>
    </div>
  </div>
<% end %>