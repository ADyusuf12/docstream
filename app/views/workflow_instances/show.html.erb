<div class="max-w-5xl mx-auto space-y-8">
  <div class="flex items-center justify-between bg-white p-8 rounded-[2rem] border border-slate-200 shadow-sm">
    <div class="flex items-center space-x-6">
      <div class="h-14 w-14 bg-tirs-medium text-white rounded-2xl flex items-center justify-center shadow-lg shadow-emerald-900/20">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" stroke-width="2"/></svg>
      </div>
      <div>
        <h1 class="text-2xl font-black text-slate-900 tracking-tight leading-none mb-2"><%= @workflow.document.title %></h1>
        <%# Listening on the shared document_status frequency %>
        <%= turbo_stream_from "document_status_#{@workflow.document.id}" %>
        <div id="status_badge">
          <%= render "shared/status_badge", state: @workflow.aasm_state %>
        </div>
      </div>
    </div>
    <div class="flex items-center space-x-3">
      <% if @workflow.approved? %>
        <%= link_to certificate_workflow_instance_path(@workflow), target: "_blank", class: "px-6 py-3 bg-slate-900 text-white rounded-xl font-bold text-sm hover:bg-black transition-all shadow-lg flex items-center" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" stroke-width="2"/></svg>
          View Digital Certificate
        <% end %>
      <% end %>
      <% if current_user.approver? && @workflow.pending? %>
        <%= button_to approve_workflow_instance_path(@workflow), method: :patch, data: { turbo_frame: "_top" }, class: "px-6 py-3 bg-tirs-medium text-white rounded-xl font-bold text-sm hover:bg-tirs-dark transition-all shadow-lg flex items-center" do %>
          Approve & Seal
        <% end %>
        <%= button_to reject_workflow_instance_path(@workflow), method: :patch, data: { turbo_frame: "_top" }, class: "px-6 py-3 bg-white border-2 border-rose-100 text-rose-600 rounded-xl font-bold text-sm hover:bg-rose-50 transition-all flex items-center" do %>
          Reject
        <% end %>
      <% end %>
    </div>
  </div>
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <div class="lg:col-span-2 space-y-8">
      <div class="bg-white rounded-[2rem] border border-slate-200 overflow-hidden shadow-sm">
        <div class="bg-slate-50 px-8 py-4 border-b border-slate-200 flex justify-between items-center">
          <h3 class="text-xs font-black text-slate-500 uppercase tracking-widest leading-none">AI Briefing Note</h3>
          <% unless @workflow.document.versions.exists?(ai_generated: true) %>
            <%= button_to generate_memo_document_path(@workflow.document), method: :post, class: "text-[10px] font-black uppercase text-indigo-600 hover:text-indigo-700 transition-colors flex items-center" do %>
              <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M13 10V3L4 14h7v7l9-11h-7z" stroke-width="2.5"/></svg>
              Run Neural Analysis
            <% end %>
          <% end %>
        </div>
        <div class="p-8" id="ai_section">
          <% if (ai_version = @workflow.document.versions.find_by(ai_generated: true)) %>
            <%= render "documents/ai_result", version: ai_version %>
          <% else %>
            <div class="py-4">
              <p class="text-slate-400 italic text-sm">No AI analysis available for this document.</p>
            </div>
          <% end %>
        </div>
      </div>
      <div class="bg-white rounded-[2rem] border border-slate-200 p-8 shadow-sm text-left">
        <h3 class="text-xs font-black text-slate-900 uppercase tracking-widest mb-8">Process Timeline</h3>
        <div class="space-y-8 relative">
          <div class="absolute left-[11px] top-2 bottom-2 w-0.5 bg-slate-100"></div>
          <%# 1. Initiation Step %>
          <div class="relative flex items-start group">
            <div class="h-6 w-6 rounded-full bg-tirs-medium border-4 border-white shadow-sm z-10"></div>
            <div class="ml-6">
              <p class="text-xs font-black text-slate-400 uppercase tracking-widest mb-1">Initiation</p>
              <p class="text-sm font-bold text-slate-900 leading-none">
                Filed by <%= @workflow.document.user.email %>
              </p>
              <p class="text-[10px] text-slate-400 mt-1 font-medium italic">
                <%= @workflow.created_at.strftime("%d %b %Y at %I:%M %p") %>
              </p>
            </div>
          </div>
          <%# 2. Decision Step (Dynamic) %>
          <% if @workflow.approved? || @workflow.rejected? %>
            <%
        # Re-using your forensic logic to find the specific actor for the status change
        decision_audit = @workflow.audits.where(action: "update").find do |a|
          a.audited_changes["aasm_state"]&.last == @workflow.aasm_state
        end
        actor_email = decision_audit&.user&.email || "System/Unknown"
      %>
            <div class="relative flex items-start">
              <div class="h-6 w-6 rounded-full <%= @workflow.approved? ? 'bg-tirs-medium' : 'bg-rose-500' %> border-4 border-white shadow-sm z-10"></div>
              <div class="ml-6">
                <p class="text-xs font-black text-slate-400 uppercase tracking-widest mb-1">Final Decision</p>
                <p class="text-sm font-bold text-slate-900 leading-none">
                  <%= @workflow.aasm_state.capitalize %> by <%= actor_email %>
                </p>
                <p class="text-[10px] text-slate-400 mt-1 font-medium italic">
                  <%= @workflow.updated_at.strftime("%d %b %Y at %I:%M %p") %>
                </p>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
    <div class="space-y-6">
      <div class="bg-slate-900 rounded-[2rem] p-8 text-white shadow-xl text-left">
        <h3 class="text-tirs-light text-[10px] font-black uppercase tracking-widest mb-6">Security Context</h3>
        <div class="space-y-4">
          <div>
            <span class="block text-[10px] font-bold text-slate-500 uppercase">Filing ID</span>
            <span class="text-xs font-mono text-emerald-100/80">TIRS-<%= @workflow.id %>-<%= @workflow.created_at.to_i %></span>
          </div>
          <div class="pt-4 border-t border-white/10">
            <%= link_to document_path(@workflow.document), class: "text-[10px] font-black uppercase text-tirs-light hover:text-white transition-colors" do %>
              View Source File &rarr;
            <% end %>
          </div>
        </div>
      </div>
      <div class="bg-white rounded-[2rem] border border-slate-200 p-8 shadow-sm text-left">
        <h3 class="text-xs font-black text-slate-900 uppercase tracking-widest mb-6">Immutable Audit Log</h3>
        <div id="audit_log_container" class="space-y-2 max-h-[400px] overflow-y-auto pr-2 custom-scrollbar">
          <% if @audits.any? %>
            <%= render partial: 'audit_entry', collection: @audits, as: :audit %>
          <% else %>
            <p id="empty_audit_msg" class="text-[10px] text-slate-400 italic">No audit history recorded.</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>