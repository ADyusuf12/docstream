<div class="mb-10">
  <h1 class="text-4xl font-black text-slate-900 tracking-tight">Workflow Inbox</h1>
  <p class="text-sm text-slate-500 mt-1">
    <%= current_user.approver? ? "Pending authorizations requiring your signature." : "Tracking your document submissions." %>
  </p>
</div>
<div class="bg-white rounded-[2rem] border border-slate-200 shadow-sm overflow-hidden">
  <table class="w-full text-left border-collapse">
    <thead>
      <tr class="bg-slate-50 border-b border-slate-200">
        <th class="px-8 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">Document</th>
        <th class="px-8 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">Current Stage</th>
        <th class="px-8 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">Initiated</th>
        <th class="px-8 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest text-right">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% @workflows.each do |workflow| %>
        <tr class="hover:bg-slate-50 transition-colors group">
          <td class="px-8 py-5">
            <span class="block font-bold text-slate-900"><%= workflow.document.title %></span>
            <span class="text-[10px] text-slate-400 uppercase font-medium">Ref ID: #<%= workflow.id %></span>
          </td>
          <td class="px-8 py-5">
            <%= render "shared/status_badge", state: workflow.aasm_state %>
          </td>
          <td class="px-8 py-5 text-xs font-medium text-slate-500">
            <%= workflow.created_at.strftime("%b %d, %Y") %>
          </td>
          <td class="px-8 py-5 text-right">
            <%= link_to "Review", workflow_instance_path(workflow), class: "text-xs font-black text-tirs-medium hover:text-tirs-dark uppercase tracking-wider" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>