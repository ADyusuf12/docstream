<div class="mb-10 flex flex-col md:flex-row md:items-end justify-between gap-4">
  <div>
    <h1 class="text-4xl font-black text-slate-900 tracking-tight text-left">System Audit Trail</h1>
    <p class="text-sm text-slate-500 mt-1">Immutable forensic record of all workflow transitions and security events.</p>
  </div>
  <div class="flex items-center space-x-3">
    <%= link_to admin_audits_path(format: :csv), class: "px-5 py-3 bg-white border-2 border-slate-200 text-slate-600 rounded-xl font-bold text-xs hover:bg-slate-50 transition-all flex items-center shadow-sm" do %>
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" stroke-width="2"/></svg>
      Export CSV
    <% end %>
    <div class="bg-emerald-50 px-4 py-3 rounded-xl border border-emerald-100 flex items-center">
      <div class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse mr-2"></div>
      <span class="text-[10px] font-black text-emerald-700 uppercase tracking-widest">Live Monitoring</span>
    </div>
  </div>
</div>
<div class="bg-white rounded-[2.5rem] border border-slate-200 shadow-sm overflow-hidden">
  <table class="w-full text-left border-collapse">
    <thead>
      <tr class="bg-slate-50 border-b border-slate-200">
        <th class="px-8 py-5 text-[10px] font-black text-slate-400 uppercase tracking-widest">Time & Session</th>
        <th class="px-8 py-5 text-[10px] font-black text-slate-400 uppercase tracking-widest">Authorized Actor</th>
        <th class="px-8 py-5 text-[10px] font-black text-slate-400 uppercase tracking-widest">Resource Impacted</th>
        <th class="px-8 py-5 text-[10px] font-black text-slate-400 uppercase tracking-widest">Delta (Changes)</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% @audits.each do |audit| %>
        <tr class="hover:bg-slate-50/50 transition-colors group">
          <td class="px-8 py-6">
            <span class="block text-xs font-bold text-slate-900"><%= audit.created_at.strftime("%d %b, %H:%M:%S") %></span>
            <span class="text-[9px] text-slate-400 font-mono uppercase tracking-tighter">REQ-<%= audit.request_uuid&.last(8) || 'INTERNAL' %></span>
          </td>
          <td class="px-8 py-6">
            <div>
              <% if audit.user.is_a?(User) %>
                <p class="text-xs font-bold text-slate-800 leading-none group-hover:text-emerald-600 transition-colors">
                  <%= audit.user.email.split('@').first.upcase %>
                </p>
                <p class="text-[9px] text-slate-400 font-medium mt-1 uppercase tracking-tighter"><%= audit.user.role %></p>
              <% else %>
                <p class="text-xs font-bold text-slate-400 leading-none italic">System Process</p>
              <% end %>
            </div>
          </td>
          <td class="px-8 py-6">
            <span class="px-2 py-1 rounded text-[9px] font-black uppercase tracking-widest border <%= audit.action == 'destroy' ? 'bg-rose-50 text-rose-600 border-rose-100' : 'bg-slate-100 text-slate-600 border-slate-200' %>">
              <%= audit.action %>
            </span>
            <p class="text-[10px] text-slate-900 mt-2 font-black uppercase tracking-tight">
              <%= audit.auditable_type %>
              <span class="text-slate-400 ml-1">#<%= audit.auditable_id %></span>
            </p>
          </td>
          <td class="px-8 py-6">
            <div class="space-y-2">
              <% audit.audited_changes.each do |field, values| %>
                <div class="flex flex-wrap items-center text-[10px] font-mono">
                  <span class="bg-slate-100 text-slate-500 px-1.5 py-0.5 rounded mr-2 uppercase text-[8px] font-bold"><%= field %></span>
                  <% if values.is_a?(Array) %>
                    <%# Showing the change from old to new %>
                    <span class="text-slate-400 line-through mr-2"><%= values[0].to_s.presence || "null" %></span>
                    <svg class="w-3 h-3 text-slate-300 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M14 5l7 7m0 0l-7 7m7-7H3" stroke-width="2"/></svg>
                    <span class="text-emerald-600 font-bold"><%= values[1] %></span>
                  <% else %>
                    <%# Initial creation value %>
                    <span class="text-slate-700 font-bold"><%= values %></span>
                  <% end %>
                </div>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <div class="mt-8 flex justify-center">
    <%= paginate @audits, class: "flex space-x-2" %>
  </div>
</div>