<%
  themes = {
    "indigo"  => { bg: "bg-indigo-50", text: "text-indigo-600" },
    "emerald" => { bg: "bg-emerald-50", text: "text-emerald-600" },
    "rose"    => { bg: "bg-rose-50", text: "text-rose-600" },
    "slate"   => { bg: "bg-slate-50", text: "text-slate-600" }
  }
  selected = themes[color] || themes["slate"]
%>
<div class="flex items-center gap-3 bg-white p-3 rounded-xl border border-slate-100 shadow-sm min-w-[180px] flex-1">
  <div class="h-9 w-9 shrink-0 <%= selected[:bg] %> <%= selected[:text] %> rounded-lg flex items-center justify-center">
    <% if title.include?("Workflow") %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" stroke-width="2.5"/></svg>
    <% elsif title.include?("Approval") || title.include?("Requests") %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" stroke-width="2"/></svg>
    <% elsif title.include?("Risk") || title.include?("Indicator") %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" stroke-width="2.5"/></svg>
    <% else %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" stroke-width="2"/></svg>
    <% end %>
  </div>
  <div>
    <div class="text-lg font-black text-slate-900 leading-none tabular-nums"><%= count %></div>
    <div class="text-[8px] font-bold text-slate-400 uppercase tracking-widest whitespace-nowrap"><%= title %></div>
  </div>
</div>