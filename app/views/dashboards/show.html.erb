<div class="max-w-[1600px] mx-auto px-8 py-10 space-y-6">
  <%# --- HEADER & KPI SECTION --- %>
  <div class="bg-white p-8 rounded-[2.5rem] border border-slate-200 shadow-sm space-y-8">
    <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-8">
      <div>
        <div class="flex items-center gap-3 mb-2">
          <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">System Status: Optimal</span>
        </div>
        <h1 class="text-3xl font-black text-slate-900 tracking-tight uppercase">
          TIRS <span class="text-emerald-600">Oversight</span>
        </h1>
      </div>
      <%# Compact KPI Row %>
      <div class="flex flex-wrap items-center gap-3">
        <%= render "dashboards/kpi_card", title: "Pending Workflows", count: @pending_workflows, color: "indigo" %>
        <%= render "dashboards/kpi_card", title: "Pending Requisitions", count: @pending_requisitions, color: "emerald" %>
        <%= render "dashboards/kpi_card", title: "Total Documents", count: @total_docs, color: "slate" %>
        <%= render "dashboards/kpi_card", title: "Low Stock", count: @low_stock_items.count, color: "rose" %>
      </div>
    </div>
    <%# Tab Navigation Control %>
    <div class="flex items-center gap-1 bg-slate-100 p-1 rounded-2xl w-fit border border-slate-200">
      <button onclick="switchTab(event, 'intel')" class="tab-btn active-tab px-6 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all">Intelligence</button>
      <button onclick="switchTab(event, 'logistics')" class="tab-btn px-6 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all text-slate-500">Logistics & Stock</button>
      <button onclick="switchTab(event, 'reg')" class="tab-btn px-6 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all text-slate-500">Documents Feed</button>
      <button onclick="switchTab(event, 'audit')" class="tab-btn px-6 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all text-slate-500">History Log</button>
    </div>
  </div>
  <%# --- CONTENT AREA --- %>
  <div class="bg-white rounded-[2.5rem] border border-slate-200 shadow-sm min-h-[500px] overflow-hidden">
    <%# TAB 1: INTELLIGENCE (Operator Context) %>
    <div id="intel" class="tab-panel p-10">
      <div class="max-w-2xl">
        <div class="bg-slate-50 border border-slate-200 rounded-[2rem] p-8">
          <h3 class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400 mb-6 flex items-center gap-2">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
            Operator Profile
          </h3>
          <div class="space-y-6">
            <div class="flex items-center gap-4">
              <div class="h-12 w-12 bg-slate-900 rounded-2xl flex items-center justify-center text-emerald-400 font-black text-xl">
                <%= current_user.email[0].upcase %>
              </div>
              <div class="overflow-hidden">
                <p class="text-[9px] font-bold text-slate-400 uppercase tracking-widest leading-none mb-1">Authenticated As</p>
                <p class="text-sm font-black text-slate-900 truncate"><%= current_user.email %></p>
              </div>
            </div>
            <div class="pt-6 border-t border-slate-200 grid grid-cols-2 gap-8">
              <div>
                <p class="text-[9px] font-bold text-slate-400 uppercase tracking-widest mb-1">Session Protocol</p>
                <code class="text-[10px] font-mono bg-white border border-slate-200 px-2 py-1 rounded-md text-slate-600">
                  <%= SecureRandom.hex(6).upcase %>
                </code>
              </div>
              <div>
                <p class="text-[9px] font-bold text-slate-400 uppercase tracking-widest mb-1">Access Tier</p>
                <span class="px-2 py-0.5 bg-slate-900 text-white text-[9px] font-black rounded uppercase">Administrator</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <%# TAB 2: LOGISTICS & STOCK (Combined Issuance & Inventory) %>
    <div id="logistics" class="tab-panel hidden p-10 space-y-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <%# Issuance Table (Left 8/12) %>
        <div class="lg:col-span-8 bg-white border border-slate-200 rounded-[2.5rem] overflow-hidden">
          <div class="p-8 border-b border-slate-100 flex justify-between items-center bg-slate-50/30">
            <div>
              <h3 class="text-xl font-black text-slate-900 uppercase tracking-tight">Issuance Intelligence</h3>
              <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-1">Daily throughput summary</p>
            </div>
            <div class="text-right">
              <p class="text-3xl font-black text-slate-900 tabular-nums leading-none"><%= @today_issuance_count %></p>
              <p class="text-[9px] font-bold text-emerald-500 uppercase tracking-widest">Total Today</p>
            </div>
          </div>
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-slate-50/50">
                <th class="px-8 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">Document Class</th>
                <th class="px-8 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest text-right">Volume</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% @issuance_breakdown.each do |name, count| %>
                <tr class="hover:bg-slate-50 transition-colors group">
                  <td class="px-8 py-5 text-sm font-black text-slate-700 uppercase"><%= name %></td>
                  <td class="px-8 py-5 text-right font-black text-slate-900"><%= count %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <%# Inventory Alerts (Right 4/12) %>
        <div class="lg:col-span-4 space-y-4">
          <div class="bg-slate-900 rounded-[2rem] p-8 text-white h-full">
            <h3 class="text-[10px] font-black uppercase tracking-[0.2em] text-emerald-400 mb-6">Inventory Status</h3>
            <% if @low_stock_items.any? %>
              <div class="space-y-6">
                <% @low_stock_items.limit(3).each do |item| %>
                  <div class="bg-white/5 border border-white/10 p-4 rounded-2xl">
                    <p class="text-[9px] font-bold text-rose-400 uppercase mb-1">Low Stock Alert</p>
                    <p class="text-sm font-black uppercase"><%= item.name %></p>
                    <p class="text-lg font-black text-white mt-2"><%= item.quantity %> <span class="text-xs font-normal text-slate-400">units remaining</span></p>
                  </div>
                <% end %>
                <%= link_to "Manage Inventory", inventory_items_path, class: "block w-full text-center py-4 bg-emerald-600 text-white text-[10px] font-black uppercase rounded-xl hover:bg-emerald-500 transition-all shadow-lg shadow-emerald-900/20" %>
              </div>
            <% else %>
              <div class="flex flex-col items-center justify-center py-12 text-center">
                <div class="h-12 w-12 bg-white/10 rounded-full flex items-center justify-center mb-4 text-emerald-400">✓</div>
                <p class="text-sm font-black uppercase">Stock Levels Optimal</p>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
    <%# TAB 3: REGISTRY %>
    <div id="reg" class="tab-panel hidden divide-y divide-slate-100">
      <% @latest_documents.each do |doc| %>
        <div class="flex items-center justify-between p-8 hover:bg-slate-50 transition-all group">
          <div class="flex items-center gap-6">
            <div class="h-12 w-12 bg-slate-100 rounded-2xl flex items-center justify-center text-slate-400 group-hover:bg-white group-hover:text-emerald-500 border border-transparent group-hover:border-slate-200 transition-all">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" stroke-width="2"/></svg>
            </div>
            <div>
              <p class="text-base font-black text-slate-900"><%= doc.title %></p>
              <p class="text-[10px] text-slate-400 font-bold uppercase tracking-widest">Ref: TIRS-<%= doc.id %> • Verified <%= time_ago_in_words(doc.created_at) %> ago</p>
            </div>
          </div>
          <svg class="w-5 h-5 text-slate-300 opacity-0 group-hover:opacity-100 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" stroke-width="3"/></svg>
        </div>
      <% end %>
    </div>
    <%# TAB 4: AUDIT %>
    <div id="audit" class="tab-panel hidden p-10 space-y-6">
      <% @recent_activities.each do |log| %>
        <div class="flex items-center justify-between p-6 bg-slate-50 rounded-[2rem] border border-slate-100">
          <div class="flex items-center gap-6">
            <div class="h-2.5 w-2.5 rounded-full <%= log.status == 'approved' ? 'bg-emerald-500 shadow-[0_0_10px_rgba(16,185,129,0.5)]' : 'bg-amber-500' %>"></div>
            <div>
              <p class="text-sm font-black text-slate-900 uppercase">
                <%= log.user.email.split('@').first %>
                <span class="text-slate-400 font-medium italic mx-2">—</span>
                <%= log.inventory_item.name %>
              </p>
              <p class="text-[10px] text-slate-400 font-bold uppercase tracking-widest mt-0.5"><%= log.updated_at.strftime("%H:%M:%S") %> • Status: <%= log.status %></p>
            </div>
          </div>
          <span class="px-4 py-1 bg-white border border-slate-200 text-slate-500 text-[9px] font-black uppercase rounded-lg">Traceable</span>
        </div>
      <% end %>
    </div>
  </div>
</div>
<style>
  .active-tab { background-color: white !important; color: #0f172a !important; box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1); }
  .tab-panel.hidden { display: none; }
</style>
<script>
  function switchTab(evt, tabName) {
    const panels = document.getElementsByClassName("tab-panel");
    for (let i = 0; i < panels.length; i++) { panels[i].classList.add("hidden"); }

    const btns = document.getElementsByClassName("tab-btn");
    for (let i = 0; i < btns.length; i++) {
      btns[i].classList.remove("active-tab");
      btns[i].classList.add("text-slate-500");
    }

    document.getElementById(tabName).classList.remove("hidden");
    evt.currentTarget.classList.add("active-tab");
    evt.currentTarget.classList.remove("text-slate-500");
  }
</script>