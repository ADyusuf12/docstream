<div class="fixed bottom-6 right-6 z-50">
  <div class="bg-slate-900 border border-slate-700 shadow-2xl rounded-2xl p-4 flex items-center space-x-4">
    <div class="flex flex-col">
      <span class="text-[10px] text-slate-400 font-bold uppercase tracking-widest leading-none mb-1 text-left">Demo Persona</span>
      <span class="text-white text-xs font-medium opacity-80"><%= current_user.email %></span>
    </div>
    <div class="flex bg-slate-800 rounded-lg p-1 gap-1">
      <% User.roles.keys.each do |role| %>
        <%= button_to role.titleize,
            update_role_path(role: role),
            method: :patch,
            class: "px-3 py-1.5 rounded-md text-[11px] font-bold transition-all #{current_user.role == role ? 'bg-tirs-medium text-white shadow-lg' : 'text-slate-400 hover:text-white hover:bg-slate-700'}" %>
      <% end %>
    </div>
  </div>
</div>