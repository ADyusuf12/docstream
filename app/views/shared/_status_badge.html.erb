<%
  colors = case state.to_s
           when 'approved' then 'bg-emerald-100 text-emerald-700 border-emerald-200'
           when 'pending'  then 'bg-amber-100 text-amber-700 border-amber-200'
           when 'rejected' then 'bg-rose-100 text-rose-700 border-rose-200'
           else 'bg-slate-100 text-slate-600 border-slate-200'
           end
%>
<span class="px-2.5 py-0.5 rounded-full text-xs font-bold border <%= colors %> uppercase tracking-wider">
  <%= state.to_s.humanize %>
</span>