<%= form_with(model: document, class: "space-y-8", data: { turbo: false }) do |f| %>
  <%# Error Display %>
  <% if document.errors.any? %>
    <div class="p-4 mb-6 bg-rose-50 border-l-4 border-rose-500 text-rose-700">
      <p class="font-bold">Upload Blocked:</p>
      <ul class="text-sm list-disc ml-5">
        <% document.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <%# Title Field %>
  <div class="space-y-2">
    <%= f.label :title, "Document Title", class: "text-xs font-black text-slate-400 uppercase tracking-widest ml-1" %>
    <%= f.text_field :title, placeholder: "Enter a descriptive name...", class: "w-full px-6 py-4 rounded-2xl bg-slate-50 border-2 border-slate-100 focus:border-tirs-medium focus:bg-white transition-all outline-none font-medium" %>
  </div>
  <%# File Upload Field %>
  <div class="space-y-2" data-controller="file-upload">
    <label class="text-xs font-black text-slate-400 uppercase tracking-widest ml-1">Attachment</label>
    <div class="border-2 border-dashed border-slate-200 rounded-[2rem] p-12 text-center bg-slate-50 hover:bg-slate-100 transition-all cursor-pointer relative group"
         data-file-upload-target="container">
      <%= f.file_field :file,
          class: "absolute inset-0 opacity-0 cursor-pointer z-10",
          data: {
            file_upload_target: "input",
            action: "change->file-upload#changed"
          } %>
      <%# Default State %>
      <div data-file-upload-target="label" class="transition-opacity">
        <div class="h-16 w-16 bg-white rounded-2xl shadow-sm border border-slate-200 flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform">
          <svg class="w-8 h-8 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <p class="text-sm font-bold text-slate-900 leading-none">Drop document here</p>
        <p class="text-[10px] text-slate-400 mt-2 uppercase font-black tracking-widest">or click to browse filesystem</p>
      </div>
      <%# Success State %>
      <div data-file-upload-target="preview" class="hidden animate-in fade-in zoom-in duration-300">
        <div class="h-16 w-16 bg-emerald-500 rounded-2xl shadow-lg shadow-emerald-200 flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <p class="text-sm font-black text-slate-900 leading-none filename">Document.pdf</p>
        <p class="text-[10px] text-emerald-600 mt-2 uppercase font-black tracking-widest">Ready for Neural Analysis</p>
      </div>
    </div>
  </div>
  <%# Submit Button (Inside Form) %>
  <%= f.submit "Secure & Upload", class: "w-full py-5 bg-tirs-dark text-white rounded-2xl font-black uppercase tracking-widest shadow-xl hover:bg-black transition-all cursor-pointer" %>
<% end %>