<h1 class="text-2xl font-bold mb-4">Edit Document</h1>
<%= form_with model: @document, local: true, class: "space-y-4" do |f| %>
  <div>
    <%= f.label :title, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :title, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm" %>
  </div>
  <div>
    <%= f.label :files, "Upload Files", class: "block text-sm font-medium text-gray-700" %>
    <%= f.file_field :files, multiple: true, class: "mt-1 block w-full" %>
  </div>
  <div>
    <%= f.submit "Update Document", class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
  </div>
<% end %>
